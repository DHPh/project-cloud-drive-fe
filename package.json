{
  "name": "@cloud-drive/frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:api": "openapi-typescript docs/contracts/openapi.yaml -o src/lib/api-schema.d.ts",
    "check:api": "npm run generate:api -- --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.108.4",
    "next": "16.2.12",
    "pdfjs-dist": "5.4.624",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.12",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.0"
  }
